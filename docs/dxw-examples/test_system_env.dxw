WORLD test_system_env
	NAME		System and Environment Test World
	VERSION		1.0
	AUTHOR  	Test Suite
	SITE		http://www.dimensione-x.net

ROOMS

ROOM room_nexus
	NAME		The Nexus
	DESCRIPTION	A luminous chamber with pulsing data streams.

END_ROOMS

SCRIPTS

SUB customSub
	res_sub_ran = 1
END_SUB

EVENT onStart
	' 1. ExistScript
	res_has_onstart = ExistScript("onStart")
	res_has_customsub = ExistScript("customSub")
	res_has_fake = ExistScript("nonExistentScript")

	' 2. getTime
	res_year = getTime("yyyy")
	res_time_hhmm = getTime("HH:mm")

	' 3. HttpFetch
	res_invalid_url = HttpFetch("ftp://example.com/test")

	' 4. PanelHtml
	res_panel_html = PanelHtml("default")
	res_fake_panel = PanelHtml("fake_panel_id")

	' 5. getSetting & SaveSetting
	res_setting_def = getSetting("custom_motd", "Welcome Adventurer")
	SaveSetting "hiscore", 4500
	SaveSetting "hiscoretext", "Best score: 4500 by Champion"
	res_saved_hiscore = getSetting("hiscore")
	res_saved_hiscoretext = getSetting("hiscoretext")

	Dim savedSet = NewSet("gold=300, rank=Paladin")
	SaveSetting "champion_profile", savedSet
	Dim loadedSet = getSetting("champion_profile")
	res_loaded_set_gold = loadedSet("gold")
	res_loaded_set_rank = loadedSet("rank")

	' 6. gameInfo
	res_info_worldname = gameInfo("worldname")
	res_info_site = gameInfo("site")
END_EVENT

END_SCRIPTS

END_WORLD
