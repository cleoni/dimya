WORLD test_math_functions
	NAME		Math Functions Test World
	VERSION		1.0
	AUTHOR  	Test Suite

ROOM start
	NAME		Laboratory
	DESCRIPTION	A laboratory for evaluating mathematical functions.
END_ROOMS

SCRIPTS

EVENT onStart
	' 1. Abs
	res_abs_pos = Abs(42)
	res_abs_neg = Abs(-42)
	res_abs_float = Abs(-3.14)
	res_abs_zero = Abs(0)

	' 2. Int
	res_int_pos = Int(42.8)
	res_int_neg = Int(-42.8)
	res_int_exact = Int(100)

	' 3. Log
	res_log_1 = Log(1)
	res_log_e = Round(Log(2.718281828), 2)
	res_log_100 = Round(Log(100), 4)

	' 4. Rnd
	res_rnd = Rnd()

	' 5. Round
	res_round_2 = Round(3.14159, 2)
	res_round_0 = Round(3.6)
	res_round_neg = Round(-2.7)
	res_round_exact = Round(5.555, 1)

	' 6. Sqr
	res_sqr_16 = Sqr(16)
	res_sqr_0 = Sqr(0)
	res_sqr_2 = Round(Sqr(2), 4)
END_EVENT

END_SCRIPTS

END_WORLD
