1 REM ========================================
2 REM DIMENSIONEY C64 CLIENT - PROGRAM 1 (SETUP)
3 REM TARGET: COMMODORE 64 WITH MEATLOAF DEVICE
4 REM ========================================
10 IF PEEK(55) <> 0 OR PEEK(56) <> 159 THEN POKE 55, 0 : POKE 56, 159 : CLR : GOTO 20
20 CN = 1 : QU$ = CHR$(34) : MK = 0
30 POKE 53280, 0 : POKE 53281, 0 : POKE 646, 1
40 PRINT CHR$(14) : REM SWITCH TO LOWER/UPPERCASE DISPLAY
50 DF$ = "HTTPS://TEST.DIMENSIONEX.NET/DIMYA/PHP/MULTIPLAYER.PHP"
60 PRINT "{CLR}{WHT}========================================"
70 PRINT "    DIMENSIONEY C64 CLIENT - SETUP      "
80 PRINT "========================================"
90 PRINT "{YEL}1. GAME URL (RETURN FOR DEFAULT):"
100 PRINT "{CYN}" + DF$
110 PRINT "{WHT}"; : MX = 99 : GOSUB 600
120 UR$ = DF$
125 IF IL$ <> "" THEN UR$ = IL$
130 IF LEN(UR$) > 99 THEN PRINT "{RED}URL TOO LONG (MAX 99)!" : GOTO 90
140 PRINT
150 PRINT "{YEL}2. PLAYER NICKNAME (MAX 10 CHARS):"
160 PRINT "{CYN}"; : MX = 10 : GOSUB 600 : U$ = IL$
170 CK$ = U$ : GOSUB 550
180 IF EV = 1 THEN PRINT "{RED}INVALID! USE 1-10 CHARS (A-Z, 0-9, -, .)" : GOTO 150
190 PRINT
200 PRINT "{YEL}3. PASSWORD (MAX 10 CHARS):"
210 PRINT "{CYN}"; : MX = 10 : MK = 1 : GOSUB 600 : P$ = IL$ : MK = 0
220 CK$ = P$ : GOSUB 550
230 IF EV = 1 THEN PRINT "{RED}INVALID! USE 1-10 CHARS (A-Z, 0-9, -, .)" : GOTO 200
240 PRINT
250 PRINT "{WHT}CONNECTING TO SERVER..."
260 BD$ = "{" + QU$ + "CMD" + QU$ + ":" + QU$ + "LOGIN" + QU$ + "," + QU$ + "USERNAME" + QU$ + ":" + QU$ + U$ + QU$ + "," + QU$ + "PASSWORD" + QU$ + ":" + QU$ + P$ + QU$ + "}"
270 GOSUB 410
280 IF ST$ = "503" THEN PRINT "{YEL}BUSY, RETRYING..." : FOR W = 1 TO 500 : NEXT W : GOSUB 410
290 IF ST$ <> "200" THEN PRINT "{RED}HTTP ERROR: "; ST$ : CLOSE CN : END
300 PT$ = "/STATUS" : GOSUB 500
310 IF V$ <> "OK" THEN PRINT "{RED}LOGIN FAILED! STATUS: "; V$ : PT$ = "/ERROR" : GOSUB 500 : PRINT "{RED}"; V$ : CLOSE CN : END
320 PRINT "{GRN}LOGIN VERIFIED SUCCESSFULLY!"
330 PRINT "{WHT}CLOSING TEST SESSION (LOGOUT)..."
340 BD$ = "{" + QU$ + "CMD" + QU$ + ":" + QU$ + "LOGOUT" + QU$ + "," + QU$ + "USERNAME" + QU$ + ":" + QU$ + U$ + QU$ + "," + QU$ + "PASSWORD" + QU$ + ":" + QU$ + P$ + QU$ + "}"
350 CLOSE CN : GOSUB 410 : CLOSE CN
360 PRINT "{WHT}STORING DATA IN PROTECTED RAM..."
370 GOSUB 700
380 PRINT "{CLR}{GRN}========================================"
382 PRINT "     CONFIGURATION VERIFIED & SAVED!    "
384 PRINT "========================================"
386 PRINT "{WHT}STRINGS PRESERVED AT $9F00-$9FFF:"
388 PRINT "  - URL : " + UR$
390 PRINT "  - USER: " + U$
392 PRINT "  - PASS: " + P$
394 PRINT
395 PRINT "{YEL}READY FOR PART 2!"
396 PRINT "{WHT}PLEASE LOAD AND RUN PART 2 MANUALLY:"
397 PRINT "load" + QU$ + "https://ml.vic20reloaded.com/multiplayer/c64" + QU$ + ",8"
398 PRINT "  LOAD" + QU$ + "PROGRAM2" + QU$ + ",8"
399 PRINT "  RUN"
400 END
405 REM --- HTTP POST REQUEST SUBROUTINE ---
410 CLOSE CN
415 OPEN CN, 8, 2, UR$
420 PRINT#CN, "M POST"
430 PRINT#CN, "H CONTENT-TYPE: APPLICATION/JSON"
440 PRINT#CN, "H ACCEPT: APPLICATION/JSON"
450 PRINT#CN, "H USER-AGENT: MEATLOAF/1.0 (COMMODORE 64; MEATLOAF-FIRMWARE)"
460 PRINT#CN, "B " + BD$
470 PRINT#CN, "S"
480 PRINT#CN, "STATUS"
485 ST$ = ""
490 GET#CN, A$
491 IF ST AND 64 THEN RETURN
492 IF ST AND 128 THEN ST$ = "-1" : RETURN
493 IF A$ = CHR$(13) THEN RETURN
494 ST$ = ST$ + A$
495 GOTO 490
500 REM --- JSON FIELD QUERY SUBROUTINE ---
505 PRINT#CN, "J " + PT$
510 V$ = ""
515 GET#CN, A$
520 V$ = V$ + A$
525 IF ST AND 64 THEN RETURN
530 IF ST AND 128 THEN V$ = "(N/A)" : RETURN
535 IF LEN(V$) < 250 THEN GOTO 515
540 RETURN
550 REM --- VALIDATION SUBROUTINE (CK$) ---
555 EV = 0
560 IF LEN(CK$) < 1 OR LEN(CK$) > 10 THEN EV = 1 : RETURN
565 FOR J = 1 TO LEN(CK$)
570 C$ = MID$(CK$, J, 1) : C = ASC(C$) : OK = 0
575 IF C >= 48 AND C <= 57 THEN OK = 1 : REM 0-9
580 IF C = 45 OR C = 46 THEN OK = 1    : REM '-' OR '.'
585 IF (C >= 65 AND C <= 90) OR (C >= 97 AND C <= 122) OR (C >= 193 AND C <= 218) THEN OK = 1
590 IF OK = 0 THEN EV = 1 : RETURN
595 NEXT J
599 RETURN
600 REM --- FULL-LINE INPUT SUBROUTINE (MX = MAX LEN) ---
602 IF MX = 0 THEN MX = 99
605 IL$ = ""
610 GET K$ : IF K$ = "" THEN GOTO 610
615 IF K$ = CHR$(13) THEN PRINT : MK = 0 : RETURN
620 IF K$ = CHR$(20) AND LEN(IL$) > 0 THEN IL$ = LEFT$(IL$, LEN(IL$) - 1) : PRINT CHR$(20); : GOTO 610
622 IF K$ = CHR$(20) THEN GOTO 610
625 IF LEN(IL$) >= MX OR ASC(K$) < 32 THEN GOTO 610
626 IL$ = IL$ + K$
627 IF MK = 1 THEN PRINT "*"; : GOTO 610
628 PRINT K$; : GOTO 610
700 REM --- POKE STRINGS TO HIGH MEMORY ($9F00 / 40704) ---
705 POKE 40704, 68 : POKE 40705, 89 : POKE 40706, 88 : REM MAGIC 'DYX'
710 AD = 40707
715 FOR I = 1 TO LEN(UR$) : POKE AD, ASC(MID$(UR$, I, 1)) : AD = AD + 1 : NEXT I
720 POKE AD, 0
725 AD = 40908
730 FOR I = 1 TO LEN(U$) : POKE AD, ASC(MID$(U$, I, 1)) : AD = AD + 1 : NEXT I
735 POKE AD, 0
740 AD = 40919
745 FOR I = 1 TO LEN(P$) : POKE AD, ASC(MID$(P$, I, 1)) : AD = AD + 1 : NEXT I
750 POKE AD, 0
755 RETURN
